server {
    listen 80;
    server_name boostflow.me www.boostflow.me;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name boostflow.me www.boostflow.me;

    ssl_certificate {% if ansible_virtualization_type is defined and ansible_virtualization_type == 'docker' %}/etc/nginx/ssl/fullchain.pem{% else %}/etc/letsencrypt/live/boostflow.me/fullchain.pem{% endif %};
    ssl_certificate_key {% if ansible_virtualization_type is defined and ansible_virtualization_type == 'docker' %}/etc/nginx/ssl/privkey.pem{% else %}/etc/letsencrypt/live/boostflow.me/privkey.pem{% endif %};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-SHA384;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;
    ssl_stapling on;
    ssl_stapling_verify on;

    # Firebase Auth Action Handler - specific route for email verification
    location /auth-handler/auth/action {
        proxy_pass {% if ansible_virtualization_type is defined and ansible_virtualization_type == 'docker' %}http://boostflow-app:{{ app_port }}{% else %}http://localhost:{{ app_port }}{% endif %};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 86400;
    }

    location / {
        proxy_pass {% if ansible_virtualization_type is defined and ansible_virtualization_type == 'docker' %}http://boostflow-app:{{ app_port }}{% else %}http://localhost:{{ app_port }}{% endif %};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 86400;
    }

    # MinIO reverse proxy for file access
    location /minio/ {
        # Enable debug logging for MinIO proxy
        error_log /var/log/nginx/minio_debug.log debug;
        
        rewrite ^/minio/(.*) /$1 break;
        proxy_pass {% if ansible_virtualization_type is defined and ansible_virtualization_type == 'docker' %}http://minio:9000{% else %}http://localhost:9000{% endif %};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 86400;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        
        # MinIO specific headers
        proxy_set_header Authorization $http_authorization;
        proxy_pass_header Authorization;
        
        # Handle OPTIONS requests for CORS
        if ($request_method = 'OPTIONS') {
            add_header Access-Control-Allow-Origin *;
            add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS";
            add_header Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization";
            add_header Access-Control-Max-Age 1728000;
            add_header Content-Type 'text/plain; charset=utf-8';
            add_header Content-Length 0;
            return 204;
        }
        
        # CORS headers for file access
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization" always;
    }

    # Static files caching
    location /_next/static/ {
        proxy_pass {% if ansible_virtualization_type is defined and ansible_virtualization_type == 'docker' %}http://boostflow-app:{{ app_port }}{% else %}http://localhost:{{ app_port }}{% endif %};
        proxy_cache_valid 200 1y;
        add_header Cache-Control "public, immutable";
    }

    # Error and access logs
    error_log /var/log/nginx/{{ app_name }}_error.log;
    access_log /var/log/nginx/{{ app_name }}_access.log;
}